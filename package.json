{
  "name": "randomizer-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "D20DAO randomizer demo: every @d20dao/vrf-sdk randomness option on Arc, with the latest results stored on-chain and a live single-page UI.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "build:frontend": "node scripts/build-frontend.mjs",
    "build": "npm run compile && npm run build:frontend",
    "check:service": "node scripts/check-service.mjs --network all",
    "simulate": "node scripts/simulate.mjs --network all",
    "deploy:testnet": "node scripts/deploy.mjs --network testnet",
    "deploy:mainnet": "node scripts/deploy.mjs --network mainnet",
    "serve": "node scripts/serve.mjs",
    "test:local": "node test/local-e2e.mjs",
    "test:local:keep": "node test/local-e2e.mjs --keep",
    "deploy:worker": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@d20dao/vrf-sdk": "0.3.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "hardhat": "2.29.1",
    "solc": "0.8.28",
    "wrangler": "^4.132.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d20dao/randomizer-demo.git"
  },
  "homepage": "https://mainnet-demo.d20dao.org"
}
